APP_NAME=ticket-api
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://ticket_user:replace-with-local-password@localhost:5432/ticket_api

# Docker Compose uses the same database credentials with the internal host name "db".
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=ticket_api

# JWT authentication
JWT_SECRET_KEY=replace-with-a-random-secret